# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key      # server-only, never expose to clients
SUPABASE_ANON_KEY=your-anon-key                       # used to verify incoming user JWTs
SUPABASE_JWT_SECRET=your-jwt-secret

# Upstash Redis (REST API)
UPSTASH_REDIS_REST_URL=https://YOUR-REDIS.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# CORS — comma-separated list of exact production origins allowed to call
# this API (e.g. https://app.zooli.com,https://vendor.zooli.com). Not
# needed for local dev — localhost is always allowed there.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------
# Vendor registration — security & notifications
# Every external dependency has a mock|live switch. Mock needs no accounts.
# ---------------------------------------------------------------------
# 32+ random chars. Signs the captcha session + OTP proof. REQUIRED in production.
APPLY_SESSION_SECRET=
# base64 of 32 random bytes — encrypts Aadhaar/PAN/bank/licence numbers. REQUIRED in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACK THIS UP: if it's lost, encrypted values cannot be recovered.
DATA_ENCRYPTION_KEY=
# encrypted = keep full Aadhaar (encrypted, admin can reveal) | masked_only = store only last 4 digits
AADHAAR_STORAGE=encrypted

# Mobile OTP. mock = fixed code, no SMS sent.  live = real SMS via SMS_PROVIDER.
OTP_MODE=mock
OTP_MOCK_CODE=123456
# false = applicants are NOT asked for an OTP (current setting). true = they must verify before submit.
OTP_REQUIRED=false

# Status / credentials SMS. mock = printed in the API console.  live = sent via SMS_PROVIDER.
SMS_MODE=mock
SMS_PROVIDER=msg91            # msg91 | twilio
MSG91_AUTH_KEY=
MSG91_TEMPLATE_OTP=           # DLT templates; placeholders named var1, var2, ...
MSG91_TEMPLATE_STATUS=        #   status: var1=reference, var2=message
MSG91_TEMPLATE_CREDENTIALS=   #   credentials: var1=reference, var2=email, var3=temp password
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Email. mock = printed in the API console.  live = sent via Resend.
EMAIL_MODE=mock
RESEND_API_KEY=
EMAIL_FROM="Zooli <no-reply@zooli.in>"

# Captcha (Cloudflare Turnstile). mock = a dev button.  live = real widget.
CAPTCHA_MODE=mock
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Where approved vendors log in (used in the credentials message)
VENDOR_PORTAL_URL=http://localhost:3001
